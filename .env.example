# Supabase — local dev points at the local stack (port 54326).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54326
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: service-role key for server-side admin operations that must
# bypass RLS (e.g. creating users from the Users page). Never expose to the
# browser. Not required for admin login.
# SUPABASE_SECRET_KEY=
